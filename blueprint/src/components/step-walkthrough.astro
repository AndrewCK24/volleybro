---
import type { StepWalkthroughBlock } from "../lib/step-walkthrough-block";
import { renderCodeHtml } from "../lib/highlight-html";

const { node: block } = Astro.props as { node: StepWalkthroughBlock };
const mainRow = block.flow.filter(({ branch }) => !branch);
const branchUnder = (id: string) => block.flow.find(({ branch }) => branch?.under === id);
const tone = {
  neutral: "bg-muted text-muted-foreground",
  warning: "bg-warning/15 text-warning-text",
  primary: "bg-primary/15 text-primary-text",
  destructive: "bg-error/15 text-error-text",
};
const shape = {
  terminal: "rounded-full border px-3 py-1",
  process: "rounded-[3px] border px-2 py-1",
  decision: "step-walkthrough-decision px-5 py-1.5",
};
const codeHtml = new Map<string, string>();
for (const scenario of block.scenarios)
  for (const step of scenario.steps)
    for (const { code } of Object.values(step.actors))
      if (code && !codeHtml.has(code))
        codeHtml.set(code, await renderCodeHtml(code, block.codeLanguage));
const firstNode = block.scenarios[0].steps[0].node;
const firstStatus = `1/${block.scenarios[0].steps.length}　${block.scenarios[0].steps[0].title}`;
// A real control size: 36px under a fine pointer, 44px on touch (DESIGN.md controls rule).
const control = "min-h-9 pointer-coarse:min-h-11";
---

<section
  class="step-walkthrough not-prose my-6 rounded-2xl border border-border p-4 text-sm"
  data-step-walkthrough
  aria-label={block.title}
>
  <div class="mb-3 overflow-x-auto rounded-xl border border-dashed border-border p-3" aria-hidden="true">
    <div class="grid w-max gap-x-1 gap-y-1.5" style={`grid-template-columns: repeat(${mainRow.length}, auto)`}>
      {mainRow.map((flowNode, index) => (
        <div class="flex items-center gap-1">
          <span
            class:list={["step-walkthrough-node inline-block text-xs leading-tight whitespace-nowrap", shape[flowNode.kind]]}
            data-flow-node={flowNode.id}
            data-active={flowNode.id === firstNode ? "true" : undefined}
          >{flowNode.label}</span>
          {index < mainRow.length - 1 && <span class="text-muted-foreground">→</span>}
        </div>
      ))}
      {mainRow.map((flowNode) => {
        const branch = branchUnder(flowNode.id);
        return (
          <div class="min-h-6">
            {branch && (
              <div class="flex flex-col items-start gap-0.5">
                <span class="pl-3 text-xs text-muted-foreground">↓ {branch.branch!.note}</span>
                <span
                  class:list={["step-walkthrough-node inline-block text-xs leading-tight whitespace-nowrap", shape[branch.kind]]}
                  data-flow-node={branch.id}
                  data-active={branch.id === firstNode ? "true" : undefined}
                >{branch.label}</span>
              </div>
            )}
          </div>
        );
      })}
    </div>
    {block.legend && (
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground">
        {(["terminal", "process", "decision"] as const).map((kind) =>
          block.legend![kind] && (
            <span class="flex items-center gap-1">
              <span class:list={["step-walkthrough-node inline-block h-3 w-5 !p-0", shape[kind]]} />
              {block.legend![kind]}
            </span>
          ),
        )}
      </div>
    )}
  </div>

  <p class="sr-only" aria-live="polite" data-step-status>{firstStatus}</p>

  <div class="mb-3 flex flex-wrap gap-1.5">
    {block.scenarios.map((scenario, index) => (
      <button
        type="button"
        class:list={[control, "rounded-full border border-border px-3 text-xs aria-pressed:border-transparent aria-pressed:bg-primary aria-pressed:text-primary-foreground"]}
        data-scenario={scenario.id}
        aria-pressed={index === 0 ? "true" : "false"}
      >{scenario.label}</button>
    ))}
  </div>

  {block.scenarios.map((scenario, scenarioIndex) => (
    <div data-scenario-panel={scenario.id} hidden={scenarioIndex !== 0}>
      <p class="mb-3 text-muted-foreground">{scenario.intro}</p>
      {scenario.steps.map((step, stepIndex) => (
        <div data-step={stepIndex} data-node={step.node} hidden={stepIndex !== 0}>
          <p class="mb-3 rounded-lg bg-muted px-3 py-2 font-medium" data-step-title>
            {stepIndex + 1}/{scenario.steps.length}　{step.title}
          </p>
          <div class="mb-3 flex flex-col gap-3 sm:flex-row">
            {block.actors.map((actor) => {
              const state = step.actors[actor.id];
              return (
                <div class="min-w-0 flex-1 rounded-xl border border-border bg-card p-3">
                  <div class="mb-2 flex items-center justify-between gap-2">
                    <span class="text-xs font-semibold text-muted-foreground">{actor.label}</span>
                    {state.status && (
                      <span class:list={["rounded-full px-2 py-0.5 text-xs font-medium", tone[state.status.tone]]}>
                        {state.status.label}
                      </span>
                    )}
                  </div>
                  <div class:list={["mb-2 text-center text-2xl font-bold", state.highlight && "step-walkthrough-flash"]}>
                    {state.headline}
                  </div>
                  <div class="space-y-1 text-xs leading-snug text-muted-foreground">
                    {state.lines.map((line) => <div>{line}</div>)}
                  </div>
                  {state.code && <div class="mt-2 text-xs [&_figure]:my-0" set:html={codeHtml.get(state.code)} />}
                </div>
              );
            })}
          </div>
          <p class="rounded-lg border border-dashed border-border px-3 py-2 text-xs leading-snug text-muted-foreground">
            <span class="mr-2 font-semibold text-foreground">{block.systemLabel}</span>{step.system}
          </p>
        </div>
      ))}
      <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
        <button type="button" data-step-nav="previous" class:list={[control, "rounded-md border border-border px-3 text-xs disabled:opacity-40"]} disabled>← 上一步</button>
        <div class="order-first flex w-full justify-center sm:order-none sm:w-auto">
          {scenario.steps.map((_, stepIndex) => (
            <button
              type="button"
              data-step-target={stepIndex}
              aria-label={`第 ${stepIndex + 1} 步`}
              aria-current={stepIndex === 0 ? "step" : undefined}
              class="group grid size-9 place-items-center pointer-coarse:size-11"
            ><span class="size-3 rounded-full bg-border group-aria-[current=step]:bg-primary" /></button>
          ))}
        </div>
        <button
          type="button"
          data-step-nav="next"
          class:list={[control, "rounded-md border border-border px-3 text-xs disabled:opacity-40"]}
          disabled={scenario.steps.length === 1}
        >下一步 →</button>
      </div>
    </div>
  ))}
</section>

<style>
  .step-walkthrough-node {
    border-color: var(--border);
    background: var(--card);
    color: var(--muted-foreground);
    transition: background-color 150ms, color 150ms;
  }
  .step-walkthrough-node.step-walkthrough-decision {
    background: var(--muted);
    clip-path: polygon(12% 0, 88% 0, 100% 50%, 88% 100%, 12% 100%, 0 50%);
  }
  .step-walkthrough-node[data-active] {
    border-color: transparent;
    background: var(--primary);
    color: var(--primary-foreground);
    font-weight: 600;
  }
  @keyframes step-walkthrough-flash {
    from { background: color-mix(in oklch, var(--warning) 45%, transparent); }
    to { background: transparent; }
  }
  .step-walkthrough-flash {
    border-radius: 0.5rem;
    animation: step-walkthrough-flash 1.2s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .step-walkthrough-flash { animation: none; }
  }
</style>

<script>
  import { installStepWalkthroughController } from "../lib/step-walkthrough-controller";

  installStepWalkthroughController(document);
</script>
