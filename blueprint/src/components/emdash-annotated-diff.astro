---
import type { AnnotatedDiffBlock } from "../lib/annotated-diff-block";
import { renderHighlightedLinesHtml } from "../lib/highlight-html";

const { node } = Astro.props as { node: AnnotatedDiffBlock };
const html = await renderHighlightedLinesHtml(
  node.lines.map(({ kind, text }) => ({
    text,
    mark: kind === "context" ? undefined : kind,
  })),
  node.language,
);
---

<figure class="not-prose my-6">
  <figcaption class="sr-only">
    Code diff{node.language ? ` (${node.language})` : ""}
  </figcaption>
  <Fragment set:html={html} />
</figure>
