---
import { PortableText } from "emdash/ui";
import type { ChangeBlock } from "../lib/emdash-change-record";
import EmDashPortableTextBlock from "./emdash-portable-text-block.astro";
import EmDashTypedBlock from "./emdash-typed-block.astro";
import EmDashTldrBlock from "./emdash-tldr-block.astro";
import EmDashDisclosureBlock from "./emdash-disclosure-block.astro";
import EmDashAnnotatedDiff from "./emdash-annotated-diff.astro";
import EmDashCodeBlock from "./emdash-code-block.astro";
import StepWalkthrough from "./step-walkthrough.astro";

const { blocks: value, hasProseLayout = true } = Astro.props as {
  blocks: ChangeBlock[];
  hasProseLayout?: boolean;
};
---

<div
  class:list={[hasProseLayout && "prose flex-1", "emdash-portable-text"]}
  data-emdash-block-renderer="v2"
>
  <PortableText
    value={value}
    components={{
      block: {
        normal: EmDashPortableTextBlock,
        h1: EmDashPortableTextBlock,
        h2: EmDashPortableTextBlock,
        h3: EmDashPortableTextBlock,
        h4: EmDashPortableTextBlock,
        h5: EmDashPortableTextBlock,
        h6: EmDashPortableTextBlock,
        blockquote: EmDashPortableTextBlock,
      },
      type: {
        code: EmDashCodeBlock,
        tldr: EmDashTldrBlock,
        disclosure: EmDashDisclosureBlock,
        annotated_diff: EmDashAnnotatedDiff,
        decision_cards: EmDashTypedBlock,
        risk_table: EmDashTypedBlock,
        scenario: EmDashTypedBlock,
        scenario_cards: EmDashTypedBlock,
        interactive_flowchart: EmDashTypedBlock,
        diagram: EmDashTypedBlock,
        variant_gallery: EmDashTypedBlock,
        step_walkthrough: StepWalkthrough,
      },
    }}
  />
</div>

<style>
  .emdash-portable-text {
    --color-surface: var(--card);
    --color-bg-subtle: var(--muted);
    --emdash-caption-color: var(--muted-foreground);
  }
</style>
