---
import { PortableText } from "emdash/ui";
import type { DisclosureBlock } from "../lib/emdash-change-record";
import EmDashPortableTextBlock from "./emdash-portable-text-block.astro";

const { node } = Astro.props as { node: DisclosureBlock };
---

<details class="emdash-disclosure rounded-md border border-border bg-card px-4 py-3">
  <summary class="cursor-pointer font-medium text-foreground">
    {node.summary}
  </summary>
  <div class="pt-3 text-foreground">
    <PortableText
      value={node.blocks}
      components={{
        block: {
          normal: EmDashPortableTextBlock,
          h1: EmDashPortableTextBlock,
          h2: EmDashPortableTextBlock,
          h3: EmDashPortableTextBlock,
          h4: EmDashPortableTextBlock,
          h5: EmDashPortableTextBlock,
          h6: EmDashPortableTextBlock,
          blockquote: EmDashPortableTextBlock,
        },
      }}
    />
  </div>
</details>

<style>
  .emdash-disclosure {
    --color-surface: var(--card);
    --color-bg-subtle: var(--muted);
    --emdash-caption-color: var(--muted-foreground);
  }
</style>
