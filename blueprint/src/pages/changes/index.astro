---
export const prerender = true;

import type { Root } from "fumadocs-core/page-tree";
import { LiveChangeCardList } from "../../components/live-change-card-list";
import { Docs } from "../../components/docs";
import Layout from "../../components/layout.astro";

const emptyTree: Root = {
  $id: "blueprint-changes-static-shell",
  name: "Changes",
  children: [],
};
---

<Layout>
  <title>Changes · Blueprint</title>
  <Docs
    client:load
    tree={emptyTree}
    pathname={Astro.url.pathname.replace(/\.html$/u, "")}
    params={Astro.params}
    hasChanges={true}
    liveChanges={true}
    page={{ breadcrumb: { includePage: false } }}
  >
    <main>
      <h1>Changes</h1>
      <LiveChangeCardList client:load />
    </main>
  </Docs>
</Layout>
