---
import { createBlueprintSources } from "../../lib/source";
import { listPublishedChangeSummaries } from "../../lib/github-change-data";
import { createChangesTree } from "../../lib/changes-tree";
import { ChangeCardList } from "../../components/change-card";
import { Docs } from "../../components/docs";
import Layout from "../../components/layout.astro";

const source = await createBlueprintSources();
const summaries = await listPublishedChangeSummaries(source.changeEntries);
const tree = createChangesTree(source.changes.pageTree, summaries.map((change) => change.href));
---

<Layout>
  <title>Changes · Blueprint</title>
  <Docs
    client:load
    tree={tree}
    pathname={Astro.url.pathname.replace(/\.html$/u, "")}
    params={Astro.params}
    hasChanges={true}
    page={{ breadcrumb: { includePage: false } }}
  >
    <main>
      <h1>Changes</h1>
      {summaries.length === 0 ? (
        <p>目前沒有已發布的 Change。</p>
      ) : (
        <ChangeCardList changes={summaries} />
      )}
    </main>
  </Docs>
</Layout>
