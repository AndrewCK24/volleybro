---
import { createChangesTree } from "../../lib/changes-tree";
import { Docs } from "../../components/docs";
import Layout from "../../components/layout.astro";
import { createBlueprintSources } from "../../lib/source";

const source = await createBlueprintSources();
const tree = createChangesTree(
  source.changes.pageTree,
  source.changeEntries.map((change) => `/changes/${change.id}`),
);
---

<Layout>
  <title>Changes · Blueprint</title>
  <Docs
    client:load
    tree={tree}
    pathname={Astro.url.pathname.replace(/\.html$/u, "")}
    params={Astro.params}
    hasChanges={true}
    page={{ breadcrumb: { includePage: false } }}
  >
    <main>
      <h1>Changes</h1>
      {source.changeEntries.length === 0 ? (
        <p>目前沒有已發布的 Change。</p>
      ) : (
        <ul>
          {source.changeEntries.map((change) => (
            <li>
              <a href={`/changes/${change.id}`}>{change.data.title}</a>
            </li>
          ))}
        </ul>
      )}
    </main>
  </Docs>
</Layout>
