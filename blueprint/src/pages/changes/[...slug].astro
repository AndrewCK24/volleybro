---
import { getRequestContext } from "emdash";
import { getDb } from "emdash/runtime";
import { env } from "cloudflare:workers";
import {
  serveChangeArtifact,
  type ChangeArtifactStore,
} from "../../lib/change-artifact";

type ArtifactRow = {
  id: string;
  slug: string;
  status: string;
  deleted_at: string | null;
  live_revision_id: string | null;
  draft_revision_id: string | null;
};
const slug = Astro.params.slug ?? "";
const db = (await getDb()).$extendTables<{
  ec_blueprint_changes: ArtifactRow;
}>();
const rows = await db
  .selectFrom("ec_blueprint_changes")
  .select(["id", "slug", "status", "live_revision_id", "draft_revision_id"])
  .where("slug", "=", slug)
  .where("deleted_at", "is", null)
  .limit(2)
  .execute();
if (rows.length > 1) {
  return new Response("Change 路徑不唯一。", {
    status: 503,
    headers: { "Cache-Control": "private, no-store" },
  });
}
const row = rows[0];
const runtime = env as {
  BLUEPRINT_PAGES: ChangeArtifactStore;
};
return serveChangeArtifact({
  request: Astro.request,
  slug,
  entry: row ? {
    id: row.id,
    slug: row.slug,
    status: row.status,
    liveRevisionId: row.live_revision_id,
    draftRevisionId: row.draft_revision_id,
  } : null,
  rendererId: import.meta.env.BLUEPRINT_RENDERER_ID ?? "",
  store: runtime.BLUEPRINT_PAGES,
  preview: getRequestContext()?.preview,
});
---
